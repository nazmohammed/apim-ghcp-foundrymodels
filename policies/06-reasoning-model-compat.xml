<!--
  STEP 6 - Step 5 + reasoning-model compatibility for Chat Completions
  Fixes: "Unsupported parameter: 'max_tokens' is not supported with this model. Use 'max_completion_tokens' instead."
  Reasoning models (gpt-5.x, o-series) reject max_tokens and non-default sampling parameters, but some clients
  (VS Code Copilot Chat / GitHub custom model proxy) still send them. The gateway normalizes the body.
-->
<policies>
  <inbound>
    <base />
    <set-variable name="model" value="@{
      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
      return (string)body[&quot;model&quot;] ?? string.Empty;
    }" />
    <choose>
      <when condition="@(!new string[] { __ALLOWED_MODELS__ }.Contains((string)context.Variables[&quot;model&quot;]))">
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"code":"model_not_allowed","message":"This model is not exposed by the gateway."}}</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition="@(context.Operation.Id == &quot;chat-completions&quot;)">
        <set-body>@{
          var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
          if (body["max_tokens"] != null)
          {
              if (body["max_completion_tokens"] == null)
              {
                  body["max_completion_tokens"] = body["max_tokens"];
              }
              body.Remove("max_tokens");
          }
          // Reasoning models only accept default sampling values.
          body.Remove("temperature");
          body.Remove("top_p");
          body.Remove("presence_penalty");
          body.Remove("frequency_penalty");
          return body.ToString();
        }</set-body>
      </when>
    </choose>
    <set-backend-service backend-id="__BACKEND_ID__" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <set-header name="api-key" exists-action="delete" />
    <llm-token-limit
      counter-key="@(context.Subscription.Id)"
      tokens-per-minute="__TOKENS_PER_MINUTE__"
      estimate-prompt-tokens="true"
      remaining-tokens-header-name="x-ratelimit-remaining-tokens" />
    <llm-emit-token-metric namespace="ghcp-byom">
      <dimension name="Subscription ID" />
      <dimension name="API ID" />
      <dimension name="Model" value="@((string)context.Request.Body.As&lt;JObject&gt;(true)[&quot;model&quot;])" />
    </llm-emit-token-metric>
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode == 503)" count="2" interval="1" first-fast-retry="true">
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

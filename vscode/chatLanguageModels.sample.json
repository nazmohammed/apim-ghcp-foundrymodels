        "vision": true,
        "maxInputTokens": 200000,
        "maxOutputTokens": 32000,
        "requestHeaders": {
          "api-key": "${apiKey}"
        }
      },
      {
        "id": "gpt-5.6-sol",
        "name": "GPT-5.6 Sol (PTU)",
        "url": "https://<your-apim>.azure-api.net/openai/v1/chat/completions",
        "toolCalling": true,
        "vision": true,
        "maxInputTokens": 200000,
        "maxOutputTokens": 32000,
        "requestHeaders": {
          "api-key": "${apiKey}"
        }
      }
    ]
  }
]

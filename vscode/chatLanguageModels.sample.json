[
  {
    "name": "Foundry PTU (via APIM)",
    "vendor": "customendpoint",
    "apiKey": "${input:apimSubscriptionKey}",
    "apiType": "chat-completions",
    "models": [
      {
        "id": "gpt-5.5",
        "name": "GPT-5.5 (PTU)",
        "url": "https://<your-apim>.azure-api.net/openai/v1/chat/completions",
